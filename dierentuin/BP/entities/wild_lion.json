{
    "format_version": "1.20.0",
    "minecraft:entity": {
        "description": {
            "identifier": "zoo:wild_lion",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "wild": {
                "minecraft:type_family": {
                    "family": ["wild_lion", "animal", "zoo_animal", "mob"]
                },
                "minecraft:behavior.avoid_mob_type": {
                    "priority": 3,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 8,
                            "walk_speed_multiplier": 1.5,
                            "sprint_speed_multiplier": 2.0
                        }
                    ]
                }
            },
            "captured": {
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 0.8
            },
            "minecraft:health": {
                "value": 20,
                "max": 20
            },
            "minecraft:movement": {
                "value": 0.35
            },
            "minecraft:navigation.walk": {
                "can_path_over_water": false,
                "avoid_water": true
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.random_stroll": {
                "priority": 6,
                "speed_multiplier": 0.8
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 8.0,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 8
            },
            "minecraft:interact": {
                "interactions": [
                    {
                        "on_interact": {
                            "filters": {
                                "all_of": [
                                    {
                                        "test": "has_equipment",
                                        "subject": "other",
                                        "domain": "hand",
                                        "value": "zoo:cage_empty"
                                    }
                                ]
                            },
                            "event": "zoo:captured",
                            "target": "self"
                        },
                        "transform_to_item": "zoo:cage_lion:0",
                        "use_item": true,
                        "interact_text": "Vang Leeuw",
                        "play_sounds": "mob.chicken.plop"
                    }
                ]
            },
            "minecraft:loot": {
                "table": "loot_tables/empty.json"
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": ["wild"]
                }
            },
            "zoo:captured": {
                "add": {
                    "component_groups": ["captured"]
                }
            }
        }
    }
}
