{
    "format_version": "1.8.0",
    "minecraft:spawn_rules": {
        "description": {
            "identifier": "zoo:wild_parrot",
            "population_control": "animal"
        },
        "conditions": [
            {
                "minecraft:spawns_on_surface": {},
                "minecraft:spawns_on_block_filter": ["minecraft:grass_block", "minecraft:jungle_log"],
                "minecraft:brightness_filter": {
                    "min": 7,
                    "max": 15,
                    "adjust_for_weather": false
                },
                "minecraft:biome_filter": {
                    "any_of": [
                        { "test": "has_biome_tag", "value": "jungle" }
                    ]
                },
                "minecraft:weight": {
                    "default": 10
                },
                "minecraft:herd": {
                    "min_size": 1,
                    "max_size": 4
                }
            }
        ]
    }
}
