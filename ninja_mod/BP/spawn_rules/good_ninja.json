{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "custom:good_ninja",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:grass_block", "minecraft:sand"],
        "minecraft:brightness_filter": {
          "min": 7,
          "max": 15,
          "adjust_for_weather": true
        },
        "minecraft:weight": { "default": 4 },
        "minecraft:herd": { "min_size": 2, "max_size": 4 },
        "minecraft:biome_filter": {
          "any_of": [
            { "test": "has_biome_tag", "value": "plains" },
            { "test": "has_biome_tag", "value": "desert" }
          ]
        }
      }
    ]
  }
}
