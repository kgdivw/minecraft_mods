{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "custom:ninja_king",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:grass_block", "minecraft:sand", "minecraft:stone", "minecraft:dirt"],
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 15,
          "adjust_for_weather": true
        },
        "minecraft:weight": { "default": 15 },
        "minecraft:herd": { "min_size": 1, "max_size": 1 },
        "minecraft:biome_filter": {
          "any_of": [
            { "test": "has_biome_tag", "value": "plains" },
            { "test": "has_biome_tag", "value": "desert" },
            { "test": "has_biome_tag", "value": "forest" },
            { "test": "has_biome_tag", "value": "taiga" },
            { "test": "has_biome_tag", "value": "savanna" },
            { "test": "has_biome_tag", "value": "jungle" }
          ]
        }
      }
    ]
  }
}
